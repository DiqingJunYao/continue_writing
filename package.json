{
  "name": "branchline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "migrate": "node --env-file-if-exists=.env server/manage.js migrate",
    "seed": "node --env-file-if-exists=.env server/manage.js seed",
    "set-admin": "node --env-file-if-exists=.env server/manage.js set-admin",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node --env-file-if-exists=.env tests/browser-smoke.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "11.3.0",
    "@fastify/static": "10.1.12",
    "fastify": "5.12.8",
    "mysql2": "3.24.6",
    "openid-client": "6.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "playwright-core": "1.60.0"
  }
}
