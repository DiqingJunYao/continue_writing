# Local development only. Keep the two passwords in sync.
MYSQL_PASSWORD=branchline-local-development
MYSQL_PORT=3307
DATABASE_URL=mysql://branchline:branchline-local-development@127.0.0.1:3307/branchline
PUBLIC_ORIGIN=http://localhost:4173
HOST=127.0.0.1
PORT=4173

# Optional for guest reading. Required for real sign-in with that provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Set this to the Graph API version enabled for your Meta app.
FACEBOOK_GRAPH_VERSION=
