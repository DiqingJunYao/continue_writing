rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Branchline uses callable Cloud Functions for every application read and
    // mutation. The Admin SDK in those functions bypasses these rules after
    // validating authentication, ownership, and administrator claims.
    // Browser clients therefore receive no direct Firestore access, including
    // when a forged token contains an `admin` custom claim.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
